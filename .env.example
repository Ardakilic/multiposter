# Copy to .env. Required values have no default; everything else shows its default.
APP_NAME=Multiposter
APP_URL=http://localhost:3000
# required, >= 32 chars; encrypts stored credentials (changing it makes saved connections unreadable)
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# required (docker compose overrides with the in-network address)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/multiposter

# S3-compatible storage (docker compose overrides S3_ENDPOINT with the in-network address)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=multiposter
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_FORCE_PATH_STYLE=true
# optional: public base URL for stored media; empty = presigned GET URLs (1h)
S3_PUBLIC_URL=

# optional: tinify PNG/JPEG/WebP uploads
TINYPNG_API_KEY=

# Nostr media host: blossom | imgur
NOSTR_MEDIA_HOST=blossom
BLOSSOM_SERVER=https://blossom.primal.net
# required when NOSTR_MEDIA_HOST=imgur
IMGUR_CLIENT_ID=

WORKER_ENABLED=true
WORKER_POLL_MS=10000
SESSION_TTL_DAYS=30
# auto = secure cookies when NODE_ENV=production; true | false
COOKIE_SECURE=auto
MAX_UPLOAD_MB=50
# false hides and blocks /register once the first account exists
ALLOW_REGISTRATION=true

# optional: email (account verification, password reset) is on iff SMTP_URL is set.
# Percent-encode special characters in the user/password (e.g. @ -> %40, : -> %3A, / -> %2F).
#   Mailpit (docker compose sets this for the local stack): smtp://mailpit:1025
#   STARTTLS:                                               smtp://user:pass@smtp.example.com:587
#   implicit TLS:                                           smtps://user:pass@smtp.example.com:465
SMTP_URL=
# sender address; the display name is APP_NAME
MAIL_FROM=no-reply@localhost
